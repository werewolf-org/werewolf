# Backend (socket.io) URL.
# Leave empty in development: the Vite dev server proxies /socket.io to
# http://localhost:3000 (see vite.config.ts), so no .env is needed at all.
# For a deploy it must be the public backend URL, e.g.
#   VITE_API_URL=https://api.example.com
# `npm run deploy` refuses to run while this is unset or points at localhost.
VITE_API_URL=

# Port for the Vite dev server.
PORT=5173
